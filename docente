<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>Dashboard Orientatore - IIS Ettore Conti</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-900 text-white p-8">
    <h1 class="text-2xl font-bold mb-6 text-blue-400">Postazione Finale Orientamento - IIS Ettore Conti</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Pannello Valutazione -->
        <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700">
            <h2 class="text-xl font-bold mb-4">Profilo Attitudinale Studente</h2>
            <div class="w-full h-64">
                <canvas id="radarChart"></canvas>
            </div>
        </div>

        <!-- Esito e Consigli per il Docente -->
        <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700 flex flex-col justify-between">
            <div>
                <h2 class="text-xl font-bold mb-2">Indirizzo Consigliato:</h2>
                <div id="recommended-path" class="text-3xl font-extrabold text-emerald-400 mb-4">...</div>
                <p id="path-description" class="text-slate-300 text-sm leading-relaxed mb-4">...</p>
            </div>
            
            <div class="bg-slate-700/50 p-4 rounded-xl text-xs text-slate-400">
                <b>Nota per il docente:</b> Utilizzare questo risultato insieme alle osservazioni sui timbri raccolti sul passaporto cartaceo per il colloquio di orientamento.
            </div>
        </div>
    </div>

    <script class="script">
        // Esempio di elaborazione dati per un profilo (C=3, D=3, B=1, A=1)
        const mockScores = { A: 1, B: 2, C: 4, D: 1 }; 

        function calculateAdvice(scores) {
            // Algoritmo di ponderazione degli indirizzi Conti
            const lsaScore = scores.D * 2 + scores.A;
            const meccScore = scores.C * 2 + scores.B;
            const elecScore = scores.C * 1.5 + scores.A * 1.5;

            let path = "";
            let desc = "";

            if (lsaScore >= meccScore && lsaScore >= elecScore) {
                path = "Liceo Scientifico Scienze Applicate";
                desc = "Lo studente mostra un'elevata inclinazione per l'indagine scientifica e il ragionamento teorico-analitico. È portato per approfondire matematica, biologia, chimica ed informatica.";
            } else if (meccScore >= elecScore) {
                path = "Istituto Tecnico - Meccanica e Meccatronica";
                desc = "Forte propensione per la modellazione spaziale (CAD), la comprensione di strutture meccaniche e dispositivi fisici. Idealmente orientato alla progettazione e alla fabbricazione.";
            } else {
                path = "Istituto Tecnico - Elettronica ed Elettrotecnica";
                desc = "Attitudine spiccata verso la logica dei sistemi, la sensoristica, l'automazione e il funzionamento dei circuiti elettrici ed elettronici.";
            }

            document.getElementById('recommended-path').innerText = path;
            document.getElementById('path-description').innerText = desc;
        }

        // Rendering Grafico a Radar (Chart.js)
        const ctx = document.getElementById('radarChart').getContext('2d');
        new Chart(ctx, {
            type: 'radar',
            data: {
                labels: ['Software/Dati (A)', 'Progettazione/CAD (B)', 'Maker/Hardware (C)', 'Ricerca/Scienza (D)'],
                datasets: [{
                    label: 'Punteggio Attitudinale',
                    data: [mockScores.A, mockScores.B, mockScores.C, mockScores.D],
                    backgroundColor: 'rgba(59, 130, 246, 0.2)',
                    borderColor: 'rgba(59, 130, 246, 1)',
                    pointBackgroundColor: 'rgba(59, 130, 246, 1)'
                }]
            },
            options: {
                scales: { r: { suggestMin: 0, suggestMax: 8, ticks: { display: false } } },
                plugins: { legend: { display: false } }
            }
        });

        calculateAdvice(mockScores);
    </script>
</body>
</html>
